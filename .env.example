# Copy this file to .env and fill in the blanks. Never commit .env.

# The integration service.
PORT=3000
LOG_LEVEL=info

# The mock CRM (Bramble Wall's membership system).
CRM_URL=http://localhost:4010
CRM_PORT=4010
# Shared by the app and the mock CRM. Any value works locally.
CRM_API_KEY=

# Shared secret for the Chalk Shop integration. Any value works locally.
CHALK_SHOP_WEBHOOK_TOKEN=

# Shared secret SlotBook signs its webhooks with (see docs/slotbook.md).
# Any value works locally; scripts/send-webhooks.js signs with the same one.
SLOTBOOK_WEBHOOK_SECRET=

# Claude API, used only by the AI cleaning-rule suggestions. Optional: without
# a key the integration still runs on its built-in and approved rules.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# on | off. Switches off the mock CRM's failure modes while you debug.
# Leave it on for your final runs: real APIs misbehave.
MOCK_CRM_CHAOS=on
