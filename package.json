{
  "name": "climbing-integration-tech-test",
  "version": "1.0.0",
  "private": true,
  "description": "Starter repository for the integration tech test: a small integration service for Bramble Wall, a fictional chain of climbing gyms.",
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "start": "node scripts/start.js",
    "app": "node --env-file-if-exists=.env src/server.js",
    "crm": "node --env-file-if-exists=.env mock-crm/server.js",
    "import": "node --env-file-if-exists=.env src/cli.js import",
    "send-webhooks": "node --env-file-if-exists=.env scripts/send-webhooks.js",
    "crm:stats": "node --env-file-if-exists=.env scripts/crm-stats.js",
    "rules:suggest": "node --env-file-if-exists=.env scripts/suggest-rules.js",
    "test": "node --test"
  }
}
